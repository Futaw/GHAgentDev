CODEX_EXECUTABLE=codex
CODEX_CLIENT_NAME=repospec_viewer
CODEX_CLIENT_TITLE=RepoSpec Viewer
CODEX_CLIENT_VERSION=0.1.0
TEST_CHAT_WORKSPACE=.
CODEX_REQUEST_TIMEOUT_SECONDS=30
CODEX_RESTART_DELAY_SECONDS=2
SSE_HEARTBEAT_SECONDS=20
SSE_EVENT_BUFFER_SIZE=500
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://repospec@127.0.0.1:5432/repospec_viewer
WORKSPACE_ROOT=.data/workspaces
GIT_EXECUTABLE=git
GIT_CLONE_TIMEOUT_SECONDS=300
GIT_SYNC_TIMEOUT_SECONDS=120
GIT_MAX_REPOSITORY_BYTES=1073741824
GIT_MAX_FILE_COUNT=100000
